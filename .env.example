# PostgreSQL (pgvector) — 접속 정보는 실제 값을 .env에만 채운다. 코드/설정에 기본값 하드코딩 금지.
# db/redis 서비스는 개별 변수를 쓰고, app 서비스는 DATABASE_URL/REDIS_URL을 통째로 쓴다.
# app이 docker-compose 네트워크 안에서 돌 때는 호스트명이 db/redis, 로컨트 스크립트에서
# 직접 붙을 때는 localhost를 쓴다. 값 확정은 Task 3(core/config.py)에서 재검토한다.
POSTGRES_USER=discovery
POSTGRES_PASSWORD=
POSTGRES_DB=discovery
DATABASE_URL=

# Redis — 대화 세션 관리
REDIS_URL=

# LLM Provider — mock(기본값) | bedrock. Task 7에서 둘 다 구현됨.
# 로컬 개발 단계에서는 mock을 기본으로 유지한다. bedrock으로 바꾸려면 AWS_REGION과
# 유효한 AWS 자격증명(환경 변수 또는 ~/.aws/credentials)이 필요하다.
LLM_PROVIDER=mock

# /internal/* 라우터 전용 공유 시크릿 (X-Internal-Token 헤더 검증에 사용)
INTERNAL_API_TOKEN=

# AWS Bedrock 연동용 (LLM_PROVIDER=bedrock일 때 필수)
AWS_REGION=

# 대화 세션(Redis) — 최근 N턴만 유지하고, 매 쓰기마다 TTL을 갱신하는 sliding window 방식.
# 실사용 로그가 쌓이면 이 값들을 재튜닝한다.
CHAT_HISTORY_MAX_TURNS=20
CHAT_SESSION_TTL_SECONDS=3600
