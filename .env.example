# Redis — 대화 세션 관리
REDIS_URL=

# LLM Provider — mock(기본값) | bedrock. Task 7에서 둘 다 구현됨.
# 로컬 개발 단계에서는 mock을 기본으로 유지한다. bedrock으로 바꾸려면 AWS_REGION과
# 유효한 AWS 자격증명(환경 변수 또는 ~/.aws/credentials)이 필요하다.
LLM_PROVIDER=mock

# /internal/* 라우터 전용 공유 시크릿 (X-Internal-Token 헤더 검증에 사용)
INTERNAL_API_TOKEN=

# AWS Bedrock 연동용 (LLM_PROVIDER=bedrock일 때 필수, 서울 ap-northeast-2 권장)
AWS_REGION=ap-northeast-2

# 추천 에이전트 및 오케스트레이터 Bedrock 모델 ID.
# Claude Haiku 4.5 글로벌 크로스리전 프로필 (CLIAR-278, 2026-09-04) — Sonnet 5 대비
# 레이턴시 개선. 롤백 시 아래 주석의 Sonnet 5 값으로 되돌린다.
LIBRARIAN_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
ORCHESTRATOR_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
GENRE_CLASSIFIER_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# LIBRARIAN_MODEL_ID=global.anthropic.claude-sonnet-5
# ORCHESTRATOR_MODEL_ID=global.anthropic.claude-sonnet-5
# GENRE_CLASSIFIER_MODEL_ID=global.anthropic.claude-sonnet-5

# 사서 에이전트(backend-librarian) 서비스 URL 및 통신 설정.
# 미설정 시 consult_librarian_tool은 graceful하게 준비 중 스텁 응답을 반환합니다.
# LIBRARIAN_AGENT_URL=http://localhost:8000
LIBRARIAN_DEFAULT_ID=cat
LIBRARIAN_HTTP_TIMEOUT_SECONDS=20
# CLIAR-289: Bedrock 자동 프롬프트 캐싱 및 송파 교육장 기본 좌표 설정
ENABLE_PROMPT_CACHING=true
DEFAULT_LATITUDE=37.5145
DEFAULT_LONGITUDE=127.1058

# CLIAR-276: 기존 Prometheus/Grafana/Loki 관측 스택과 완전히 분리된 AWS CloudWatch 커스텀
# 메트릭(Bedrock 비용 USD, 토큰 사용량, 검색 캐시 히트율) 발행 스위치. 기본 false — 켜기
# 전엔 core/cloudwatch_metrics.py 코드 경로 자체가 실행되지 않는다. IRSA Role
# (dpyb-discovery-dev-bedrock)에 cloudwatch:PutMetricData 권한이 있어야 실제로 발행된다.
ENABLE_CLOUDWATCH_METRICS=false

# 서재 도서 CRUD API (backend-book) 서비스 URL 및 통신 설정.
LIBRARY_API_URL=http://k8s-dpybbook-backendb-d17a725d36-1113312703.ap-northeast-2.elb.amazonaws.com
LIBRARY_HTTP_TIMEOUT_SECONDS=10

# CLIAR-237: 추천 도서 페이지수를 알라딘 실조회로 검증하는 backend-book 서지 조회
# 엔드포인트(GET /api/v1/books/search?isbn=...). backend-book과 동일 서비스라 기본값을
# LIBRARY_API_URL과 동일하게 둔다. 타임아웃은 실패해도 응답 전체를 막지 않을 정도로만
# 짧게 잡되(다른 페이지수 검증 요청과 병렬 실행됨), dev 실측(2026-09-04)에서 정상 응답이
# ~1.8초인데 3초는 자주 ReadTimeout으로 실패해 8초로 상향했다(CLIAR-282 후속).
BOOK_METADATA_API_URL=http://k8s-dpybbook-backendb-d17a725d36-1113312703.ap-northeast-2.elb.amazonaws.com
BOOK_METADATA_TIMEOUT_SECONDS=8

# CLIAR-282 Task 5: 서지 정보·장르 분류 결과는 출판된 도서 기준 거의 불변 데이터라
# Redis에 캐싱해 재추천 시 알라딘 외부 HTTP/Bedrock LLM 호출을 완전히 건너뛴다.
BOOK_METADATA_CACHE_TTL_SECONDS=604800
GENRE_CLASSIFIER_CACHE_TTL_SECONDS=604800

# Tavily 웹 검색 (도서 후보 실시간 조회). API 키는 tavily.com에서 발급받아 채운다.
# 무료 티어는 월 1,000 크레딧 — 비용 방어를 위해 캐시 TTL과 월간 호출 상한을 둔다.
TAVILY_API_KEY=
TAVILY_CACHE_TTL_SECONDS=86400
TAVILY_MONTHLY_CREDIT_LIMIT=900

# 대화 세션(Redis) — 최근 N턴만 유지하고, 매 쓰기마다 TTL을 갱신하는 sliding window 방식.
# 실사용 로그가 쌓이면 이 값들을 재튜닝한다.
CHAT_HISTORY_MAX_TURNS=20
CHAT_SESSION_TTL_SECONDS=3600

# CORS 허용 오리진 (콤마로 구분). 프론트 배포 도메인 + 로컬 개발 주소.
CORS_ALLOWED_ORIGINS=https://d1wab52ln5by5k.cloudfront.net,http://localhost:3000
